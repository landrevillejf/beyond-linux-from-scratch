      "gtk3": "branding/default/themes/gtk-3.20/",
      "gtk4": "branding/default/themes/gtk-4.0/",
      "xfce": "branding/default/themes/xfce.xml"
    },
    "dark": {
      "gtk_theme": "LFS-Dark",
      "icon_theme": "Papirus-Dark",
      "cursor_theme": "Adwaita",
      "background_color": "#0d0d14",
      "text_color": "#f0f0f0"
    },
    "light": {
      "gtk_theme": "LFS-Light",
      "icon_theme": "Papirus",
      "cursor_theme": "Adwaita",
      "background_color": "#f5f5f5",
      "text_color": "#1a1a2e"
    }
  },
  "desktop_environments": {
