# ============================================================================
# LINUX KERNEL CONFIGURATION (x86_64)
# ============================================================================

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_DEFAULT_HOSTNAME="lfs-desktop"
CONFIG_LOCALVERSION="-lfs"

# Serial console: lets the QEMU boot smoke test (tools/qemu-boot-smoke.sh)
# observe kernel and userspace output with console=ttyS0.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ============================================================================
# PROCESSOR TYPE AND FEATURES (x86_64)
# ============================================================================
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PREEMPT_RT=y  (uncomment for real-time audio)

# ============================================================================
# DEVICE DRIVERS
# ============================================================================
# PCI bus.  This MUST be named explicitly.  lfs/08-build-kernel.sh copies the
# fragment to .config and runs `make olddefconfig`, which resolves every symbol
# absent from the fragment to its default -- and PCI resolves to n.  SATA_AHCI
# and ATA_PIIX depend on `ATA && PCI`, BLK_DEV_NVME depends on PCI, VIRTIO_PCI
# depends on PCI, and the E1000/E1000E/R8169/IWLWIFI NICs plus SND_HDA_INTEL/
# SND_PCI are all PCI devices -- so a missing CONFIG_PCI silently dropped every
# one of them even though each is set to =y below.  With no AHCI host driver the
# kernel never bound the QEMU q35 ICH9 SATA controller, created no /dev/sda, and
# the busybox initramfs dropped to a shell with "Root device not found", failing
# the boot smoke test for every x86_64 profile that reached it (Nightly
# #228/#229).  The wait_for_dev poll added for #227 could not mask this:
# built-in drivers probe synchronously before /init runs, so there was never a
# late-appearing device node to wait for.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y

# Audio drivers
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_PCI=y

# Network drivers
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_ATH9K=y
CONFIG_IWLWIFI=y

# Storage drivers
#
# Boot-critical block stack.  lfs/08-build-kernel.sh seeds .config from this
# fragment then runs `make olddefconfig`, which leaves every symbol not named
# here at its default -- and SCSI, BLK_DEV_SD, BLK_DEV_INITRD and DEVTMPFS all
# default to n.  CONFIG_ATA depends on SCSI, so with SCSI unset olddefconfig
# silently dropped ATA and SATA_AHCI as well: the kernel could not see the QEMU
# q35 AHCI disk (nor a real SATA/NVMe/optical disk), created no /dev nodes and
# ignored the initramfs.  The QEMU boot smoke test then panicked with
# "VFS: Cannot open root device ... unknown-block(0,0): error -6" and an empty
# partition list (Nightly #224).  These are required on real hardware too.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_BLK=y

# Initramfs + device nodes: the boot flow (final/12-create-initramfs.sh) is a
# busybox initramfs that mounts devtmpfs, resolves the root device and then
# switch_root's into it.  Without BLK_DEV_INITRD the kernel ignores -initrd and
# mounts root= directly; without DEVTMPFS the initramfs sees no /dev/sd* nodes;
# RD_ZSTD/RD_GZIP unpack the compressed cpio the initramfs stage produces.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Partition tables: host/03-create-disk-image.sh labels the disk GPT.
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Input drivers
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ============================================================================
# FILE SYSTEMS
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Live ISO boot: the initramfs (final/12-create-initramfs.sh) mounts the
# boot media (iso9660) and the live.squashfs it holds via a loop device.
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
# Both ISO stages compress with `mksquashfs -comp xz`; the decompressor is a
# separate symbol that defaults to n, so SQUASHFS alone mounts nothing and
# the live image dropped to a shell instead of switch_root'ing.
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y

# ============================================================================
# NETWORKING
# ============================================================================
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y

# ============================================================================
# SECURITY / KERNEL HARDENING  (NSA/CIA/banking-grade baseline)
# ----------------------------------------------------------------------------
# Every symbol is named explicitly: lfs/08-build-kernel.sh seeds .config from
# this fragment then runs `make olddefconfig`, which resolves any symbol absent
# here to its (often insecure) default.  The security.kernel_hardening.* config
# knobs flatten to LFS_CONFIG_SECURITY_KERNEL_HARDENING_*; 08-build-kernel.sh
# re-applies the lockdown level and MODULE_SIG_FORCE from those env vars after
# copying this fragment, so they can be tuned without editing every variant.
# ============================================================================
# --- Mandatory access control ---------------------------------------------
# SELinux is the single active LSM.  AppArmor is compiled out and dropped from
# CONFIG_LSM to resolve the former dual-LSM (SELINUX + APPARMOR) conflict; the
# SELinux userspace/policy lands in Phase 2 -- until then the kernel LSM is
# built in and runs with no policy loaded (harmless; the system still boots).
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_LSM="lockdown,yama,integrity,selinux"
CONFIG_SECURITY_YAMA=y
# --- Kernel lockdown (integrity by default; confidentiality/off via knob) ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCKDOWN_KERNEL_FORCE_INTEGRITY=y
# --- Signed kernel modules (SHA-512); FORCE re-applied from the env knob ----
# The build auto-generates certs/signing_key.pem (openssl is installed by
# lfs/05b-build-lfs-system.sh before the kernel stage); the private key is
# never shipped -- only its public half is embedded in vmlinuz.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# --- Memory / allocation hardening ---------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOMIZED=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
# --- Integrity measurement (compiled in; appraisal policy lands in Phase 5) -
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y
# --- eBPF hardening -------------------------------------------------------
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# --- Close the legacy kernel-memory window --------------------------------
# /dev/mem is removed outright.  (CONFIG_DEVKMEM was deleted from the kernel
# years ago, so there is nothing left to disable.)
# CONFIG_DEVMEM is not set
# --- Credential / notifier sanity checks (require DEBUG_KERNEL) -----------
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_CREDENTIALS=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_CRYPTO=y
# FIPS 140 mode: enables the fips=1 kernel boot param and the crypto API's
# power-on self-tests (Phase 3). Built-in (=y) so the POST runs before any
# initramfs; inert unless fips=1 is present on the kernel command line.
CONFIG_CRYPTO_FIPS=y

# ============================================================================
# VIRTUALIZATION
# ============================================================================
CONFIG_KVM=y
CONFIG_VHOST_NET=y
CONFIG_VIRTIO_PCI=y