# ============================================================================
# LINUX-LIBRE KERNEL CONFIGURATION FOR GNU FREE SYSTEM
# Kernel without proprietary blobs (FSF compliant)
# ============================================================================

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_LOCALVERSION="-gnu-libre"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_DEFAULT_HOSTNAME="gnu-free"
CONFIG_INIT_ENV_ARG_LIMIT=32

# ============================================================================
# DISABLE PROPRIETARY FEATURES
# ============================================================================
# CONFIG_BINARY_PRINTF is not set
# CONFIG_DRM_LOAD_EDID_FIRMWARE is not set
# CONFIG_FIRMWARE_LOADER is not set
# CONFIG_EXTRA_FIRMWARE is not set

# ============================================================================
# CPU AND MEMORY
# ============================================================================
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# ============================================================================
# FILE SYSTEMS
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# Installer ISO boot: the initramfs (final/12-create-initramfs.sh) mounts the
# boot media (iso9660) and the live.squashfs it holds via a loop device, and
# both ISO stages compress with `mksquashfs -comp xz` whose decompressor is a
# separate symbol defaulting to n.
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y

# ============================================================================
# NETWORKING (libre)
# ============================================================================
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# ============================================================================
# DRIVERS (libres uniquement)
# ============================================================================
# Intel WiFi (libre)
CONFIG_IWLWIFI=y
CONFIG_IWLWIFI_LEDS=y

# Atheros WiFi (libre)
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y

# Ethernet (libre)
CONFIG_E1000E=y
CONFIG_R8169=y

# Audio (libre)
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_USB_AUDIO=y

# ============================================================================
# SECURITY / KERNEL HARDENING  (NSA/CIA/banking-grade baseline)
# ----------------------------------------------------------------------------
# Every symbol is named explicitly: lfs/08-build-kernel.sh seeds .config from
# this fragment then runs `make olddefconfig`, which resolves any symbol absent
# here to its (often insecure) default.  The security.kernel_hardening.* config
# knobs flatten to LFS_CONFIG_SECURITY_KERNEL_HARDENING_*; 08-build-kernel.sh
# re-applies the lockdown level and MODULE_SIG_FORCE from those env vars after
# copying this fragment, so they can be tuned without editing every variant.
# ============================================================================
# --- Mandatory access control ---------------------------------------------
# SELinux is the single active LSM (all free software, so it stays in the
# linux-libre build).  AppArmor is compiled out and dropped from CONFIG_LSM to
# resolve the former dual-LSM conflict; the SELinux userspace/policy lands in
# Phase 2.  NOTE: gnu-free disables DEBUG_KERNEL below for production, so the
# DEBUG_CREDENTIALS/DEBUG_NOTIFIERS checks (which depend on it) are omitted
# here; the rest of the hardening baseline is identical to the other variants.
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_LSM="lockdown,yama,integrity,selinux"
CONFIG_SECURITY_YAMA=y
# --- Kernel lockdown (integrity by default; confidentiality/off via knob) ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCKDOWN_KERNEL_FORCE_INTEGRITY=y
# --- Signed kernel modules (SHA-512); FORCE re-applied from the env knob ----
# The build auto-generates certs/signing_key.pem (openssl is installed by
# lfs/05b-build-lfs-system.sh before the kernel stage); the private key is
# never shipped -- only its public half is embedded in vmlinuz.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# --- Memory / allocation hardening ---------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOMIZED=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
# --- Integrity measurement (compiled in; appraisal policy lands in Phase 5) -
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y
# --- eBPF hardening -------------------------------------------------------
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# --- Close the legacy kernel-memory window --------------------------------
# /dev/mem is removed outright.  (CONFIG_DEVKMEM was deleted from the kernel
# years ago, so there is nothing left to disable.)
# CONFIG_DEVMEM is not set
CONFIG_CRYPTO=y

# ============================================================================
# VIRTUALIZATION (libre)
# ============================================================================
CONFIG_KVM=y
CONFIG_VHOST_NET=y
CONFIG_VIRTIO_PCI=y

# ============================================================================
# DEBUG (désactivé pour production)
# ============================================================================
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set