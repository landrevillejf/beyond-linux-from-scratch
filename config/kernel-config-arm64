# ============================================================================
# LINUX KERNEL CONFIGURATION (ARM64 / AArch64)
# For Raspberry Pi 4/5, Orange Pi, etc.
# ============================================================================

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_DEFAULT_HOSTNAME="lfs-arm64"

# ============================================================================
# PROCESSOR TYPE AND FEATURES (ARM64)
# ============================================================================
CONFIG_ARM64=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_64K_PAGES=y
CONFIG_NR_CPUS=8
CONFIG_PREEMPT=y

# ============================================================================
# DEVICE DRIVERS (ARM64 specific)
# ============================================================================
# Broadcom BCM2711 (Raspberry Pi 4)
CONFIG_BCM2711=y
CONFIG_BCM2835_MBOX=y
CONFIG_BCM2835_WDT=y

# Allwinner (Orange Pi)
CONFIG_SUNXI=y
CONFIG_SUN8I_THERMAL=y

# Rockchip (Rock Pi)
CONFIG_ROCKCHIP=y
CONFIG_ROCKCHIP_THERMAL=y

# Audio (ARM specific)
CONFIG_SND_BCM2835=y
CONFIG_SND_SUNXI=y

# Ethernet
CONFIG_SMSC95XX=y
CONFIG_SUNXI_EMAC=y
CONFIG_ROCKCHIP_PHY=y

# WiFi (common ARM boards)
CONFIG_BRCMFMAC=y
CONFIG_RTL8723CS=y
CONFIG_RTL8821CU=y

# GPIO
CONFIG_GPIO_BCM2835=y
CONFIG_GPIO_SUNXI=y

# ============================================================================
# PCI BUS
# ============================================================================
# SATA_AHCI and BLK_DEV_NVME in the storage stack below both depend on PCI, and
# aarch64 QEMU virt plus real ARM boards expose their SATA/NVMe/NICs over PCIe.
# `make olddefconfig` (lfs/08) resolves an unnamed CONFIG_PCI to n and silently
# drops every PCI-dependent driver, so it is named explicitly here too
# (Nightly #228/#229).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y

# ============================================================================
# STORAGE / BOOT BLOCK STACK
# ============================================================================
# Same boot-critical gap as config/kernel-config (Nightly #224): the kernel
# build seeds .config from this fragment and runs `make olddefconfig`, which
# defaults every unnamed symbol to n.  SCSI, BLK_DEV_SD, BLK_DEV_INITRD and
# DEVTMPFS all default to n, so without them the kernel ignored the initramfs,
# created no /dev nodes and could not enumerate a disk.  CONFIG_ATA depends on
# SCSI, so ATA/SATA_AHCI must be paired with it.  The arm64 profile is also
# built for x86_64 in the nightly matrix (where the QEMU q35 disk is AHCI/SATA)
# and boots via SD/MMC (root=/dev/mmcblk0p2 in CONFIG_CMDLINE) or virtio on real
# boards, so all three block backends are enabled here.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y

# Initramfs + device nodes (final/12-create-initramfs.sh): busybox initramfs
# mounts devtmpfs, resolves root, switch_root's into it.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Partition tables: host/03-create-disk-image.sh labels the disk GPT.
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ============================================================================
# BOOT OPTIONS (ARM64)
# ============================================================================
CONFIG_CMDLINE="console=ttyAMA0,115200 console=tty1 root=/dev/mmcblk0p2 rw"
CONFIG_CMDLINE_FORCE=y

# ============================================================================
# FILE SYSTEMS (ARM64)
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
# Live/installer ISO boot, the same three config/kernel-config carries: the
# initramfs (final/12-create-initramfs.sh) mounts the boot media (iso9660)
# and the live.squashfs it holds through a loop device.  Without them the
# arm64 ISO from final/14-create-installer.sh reaches the initramfs and then
# drops to a shell, because neither the media nor the squashfs on it can be
# mounted.
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
# Both ISO stages compress with `mksquashfs -comp xz`; the decompressor is a
# separate symbol that defaults to n, so SQUASHFS alone mounts nothing.
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y

# ============================================================================
# UEFI (ARM64)
# ============================================================================
# arm64 has no BIOS, so the ISO from final/14 is UEFI-only: firmware loads
# EFI/BOOT/BOOTAA64.EFI, which is GRUB, and GRUB hands the kernel over
# through the EFI stub.  Both symbols default to y on arm64, but this file is
# a seeded fragment passed through `make olddefconfig` and the block-device
# symbols above prove the defaults cannot be relied on.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ============================================================================
# NETWORKING (ARM64)
# ============================================================================
CONFIG_NETFILTER=y

# ============================================================================
# SECURITY / KERNEL HARDENING  (NSA/CIA/banking-grade baseline)
# ----------------------------------------------------------------------------
# Every symbol is named explicitly: lfs/08-build-kernel.sh seeds .config from
# this fragment then runs `make olddefconfig`, which resolves any symbol absent
# here to its (often insecure) default.  The security.kernel_hardening.* config
# knobs flatten to LFS_CONFIG_SECURITY_KERNEL_HARDENING_*; 08-build-kernel.sh
# re-applies the lockdown level and MODULE_SIG_FORCE from those env vars after
# copying this fragment, so they can be tuned without editing every variant.
# ============================================================================
# --- Mandatory access control ---------------------------------------------
# SELinux is the single active LSM.  AppArmor is compiled out and dropped from
# CONFIG_LSM to resolve the former dual-LSM (SELINUX + APPARMOR) conflict; the
# SELinux userspace/policy lands in Phase 2 -- until then the kernel LSM is
# built in and runs with no policy loaded (harmless; the system still boots).
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_LSM="lockdown,yama,integrity,selinux"
CONFIG_SECURITY_YAMA=y
# --- Kernel lockdown (integrity by default; confidentiality/off via knob) ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCKDOWN_KERNEL_FORCE_INTEGRITY=y
# --- Signed kernel modules (SHA-512); FORCE re-applied from the env knob ----
# The build auto-generates certs/signing_key.pem (openssl is installed by
# lfs/05b-build-lfs-system.sh before the kernel stage; the cross-compile path
# signs on the host, which also has openssl); the private key is never shipped.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# --- Memory / allocation hardening ---------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOMIZED=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
# --- Integrity measurement (compiled in; appraisal policy lands in Phase 5) -
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y
# --- eBPF hardening -------------------------------------------------------
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# --- Close the legacy kernel-memory window --------------------------------
# /dev/mem is removed outright.  (CONFIG_DEVKMEM was deleted from the kernel
# years ago, so there is nothing left to disable.)
# CONFIG_DEVMEM is not set
# --- Credential / notifier sanity checks (require DEBUG_KERNEL) -----------
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_CREDENTIALS=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_CRYPTO=y
# FIPS 140 mode: enables the fips=1 kernel boot param and the crypto API's
# power-on self-tests (Phase 3). Built-in (=y) so the POST runs before any
# initramfs; inert unless fips=1 is present on the kernel command line.
CONFIG_CRYPTO_FIPS=y