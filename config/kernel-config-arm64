# ============================================================================
# LINUX KERNEL CONFIGURATION (ARM64 / AArch64)
# For Raspberry Pi 4/5, Orange Pi, etc.
# ============================================================================

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_DEFAULT_HOSTNAME="lfs-arm64"

# ============================================================================
# PROCESSOR TYPE AND FEATURES (ARM64)
# ============================================================================
CONFIG_ARM64=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_64K_PAGES=y
CONFIG_NR_CPUS=8
CONFIG_PREEMPT=y

# ============================================================================
# DEVICE DRIVERS (ARM64 specific)
# ============================================================================
# Broadcom BCM2711 (Raspberry Pi 4)
CONFIG_BCM2711=y
CONFIG_BCM2835_MBOX=y
CONFIG_BCM2835_WDT=y

# Allwinner (Orange Pi)
CONFIG_SUNXI=y
CONFIG_SUN8I_THERMAL=y

# Rockchip (Rock Pi)
CONFIG_ROCKCHIP=y
CONFIG_ROCKCHIP_THERMAL=y

# Audio (ARM specific)
CONFIG_SND_BCM2835=y
CONFIG_SND_SUNXI=y

# Ethernet
CONFIG_SMSC95XX=y
CONFIG_SUNXI_EMAC=y
CONFIG_ROCKCHIP_PHY=y

# WiFi (common ARM boards)
CONFIG_BRCMFMAC=y
CONFIG_RTL8723CS=y
CONFIG_RTL8821CU=y

# GPIO
CONFIG_GPIO_BCM2835=y
CONFIG_GPIO_SUNXI=y

# ============================================================================
# STORAGE / BOOT BLOCK STACK
# ============================================================================
# Same boot-critical gap as config/kernel-config (Nightly #224): the kernel
# build seeds .config from this fragment and runs `make olddefconfig`, which
# defaults every unnamed symbol to n.  SCSI, BLK_DEV_SD, BLK_DEV_INITRD and
# DEVTMPFS all default to n, so without them the kernel ignored the initramfs,
# created no /dev nodes and could not enumerate a disk.  CONFIG_ATA depends on
# SCSI, so ATA/SATA_AHCI must be paired with it.  The arm64 profile is also
# built for x86_64 in the nightly matrix (where the QEMU q35 disk is AHCI/SATA)
# and boots via SD/MMC (root=/dev/mmcblk0p2 in CONFIG_CMDLINE) or virtio on real
# boards, so all three block backends are enabled here.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y

# Initramfs + device nodes (final/12-create-initramfs.sh): busybox initramfs
# mounts devtmpfs, resolves root, switch_root's into it.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Partition tables: host/03-create-disk-image.sh labels the disk GPT.
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ============================================================================
# BOOT OPTIONS (ARM64)
# ============================================================================
CONFIG_CMDLINE="console=ttyAMA0,115200 console=tty1 root=/dev/mmcblk0p2 rw"
CONFIG_CMDLINE_FORCE=y

# ============================================================================
# FILE SYSTEMS (ARM64)
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y

# ============================================================================
# NETWORKING (ARM64)
# ============================================================================
CONFIG_NETFILTER=y