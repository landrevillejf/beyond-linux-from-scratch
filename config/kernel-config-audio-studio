# ============================================================================
# LINUX KERNEL CONFIGURATION (x86_64) -- audio-studio profile
# ============================================================================
# Realtime variant of config/kernel-config, auto-selected by
# lfs/08-build-kernel.sh (it prefers kernel-config-$PROFILE over the
# default kernel-config).  The differences from the base config are the
# PREEMPT_RT realtime preemption model and the low-latency timer options
# required for pro-audio work (Ardour/LV2 plugin hosts on PipeWire).
# ============================================================================

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_DEFAULT_HOSTNAME="lfs-desktop"
CONFIG_LOCALVERSION="-lfs-audio"

# Serial console: lets the QEMU boot smoke test (tools/qemu-boot-smoke.sh)
# observe kernel and userspace output with console=ttyS0.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ============================================================================
# PROCESSOR TYPE AND FEATURES (x86_64)
# ============================================================================
CONFIG_SMP=y
CONFIG_NR_CPUS=64

# --- Realtime preemption model (the audio-studio promise) ---------------
# PREEMPT_RT selects CONFIG_PREEMPT and makes almost every interrupt
# threadable, giving the bounded-latency scheduling that JACK/PipeWire
# realtime audio needs.  CONFIG_EXPERT is the prerequisite that makes
# the PREEMPT_RT choice visible in the preemption-model menu.  The base
# config's voluntary preemption model is deliberately NOT carried over:
# the preemption model is a single exclusive choice.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_HPET=y

# ============================================================================
# DEVICE DRIVERS
# ============================================================================
# PCI bus -- see the identical block in config/kernel-config.  Without an
# explicit CONFIG_PCI, `make olddefconfig` (lfs/08) resolves it to n and
# silently drops every PCI-dependent driver named below (SATA_AHCI/ATA_PIIX,
# BLK_DEV_NVME, VIRTIO_PCI, the PCI NICs and SND_HDA_INTEL/SND_PCI), so the
# kernel had no AHCI host driver and the initramfs could not find the q35 SATA
# disk ("Root device not found", Nightly #228/#229).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y

# Audio drivers
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_PCI=y
# High-precision audio timing helpers
CONFIG_SND_HRTIMER=y

# Network drivers
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_ATH9K=y
CONFIG_IWLWIFI=y

# Storage drivers
#
# Boot-critical block stack -- see the identical block in config/kernel-config.
# lfs/08-build-kernel.sh seeds .config from this fragment then runs
# `make olddefconfig`, which defaults every unnamed symbol to n; SCSI,
# BLK_DEV_SD, BLK_DEV_INITRD and DEVTMPFS all default to n, and CONFIG_ATA
# depends on SCSI, so without them olddefconfig dropped ATA/SATA_AHCI and the
# kernel could not enumerate the disk, create /dev nodes or use the initramfs
# ("VFS: Cannot open root device ... unknown-block(0,0): error -6", Nightly
# #224).  The audio-studio profile reaches the same QEMU boot gate as the base
# desktop profiles, so it needs the same stack.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_BLK=y

# Initramfs + device nodes (final/12-create-initramfs.sh): busybox initramfs
# mounts devtmpfs, resolves root, switch_root's into it.  BLK_DEV_INITRD makes
# the kernel honour -initrd; DEVTMPFS provides the /dev/sd* nodes; RD_ZSTD/
# RD_GZIP unpack the compressed cpio.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Partition tables: host/03-create-disk-image.sh labels the disk GPT.
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Input drivers
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ============================================================================
# FILE SYSTEMS
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Live ISO boot: the initramfs (final/12-create-initramfs.sh) mounts the
# boot media (iso9660) and the live.squashfs it holds via a loop device.
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
# Both ISO stages compress with `mksquashfs -comp xz`; the decompressor is a
# separate symbol that defaults to n, so SQUASHFS alone mounts nothing and
# the live image dropped to a shell instead of switch_root'ing.
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y

# ============================================================================
# NETWORKING
# ============================================================================
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y

# ============================================================================
# SECURITY
# ============================================================================
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_CRYPTO=y

# ============================================================================
# VIRTUALIZATION
# ============================================================================
CONFIG_KVM=y
CONFIG_VHOST_NET=y
CONFIG_VIRTIO_PCI=y
