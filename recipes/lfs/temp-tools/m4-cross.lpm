# LFS 13.0 — 6.2. M4-1.4.20 (cross)
name="m4-cross"
version="1.4.20"
source="https://ftp.gnu.org/gnu/m4/m4-1.4.20.tar.xz"
desc="GNU M4 macro processor (temporary)"
deps="libstdcxx"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    ./configure --prefix=/usr   \
                --host="$LFS_TGT" \
                --build="$(build-aux/config.guess)"
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
}
