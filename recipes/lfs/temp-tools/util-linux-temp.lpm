# LFS 13.0 — 7.12. Util-linux-2.41.1 (chroot temporary)
name="util-linux-temp"
version="2.41.1"
source="https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.1.tar.xz"
desc="Miscellaneous system utilities (temporary)"
deps="texinfo-temp"

build() {
    mkdir -pv /var/lib/hwclock
    ./configure --libdir=/usr/lib                      \
                --runstatedir=/run                     \
                --disable-chfn-chsh                    \
                --disable-login                        \
                --disable-nologin                      \
                --disable-su                           \
                --disable-setpriv                      \
                --disable-runuser                      \
                --disable-pylibmount                   \
                --disable-static                       \
                --disable-liblastlog2                  \
                --without-python                       \
                ADJTIME_PATH=/var/lib/hwclock/adjtime  \
                --docdir=/usr/share/doc/util-linux-2.41.1
    make -j"$(nproc)"
    make install
}
