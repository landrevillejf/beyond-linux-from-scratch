# LFS 13.0 — 6.6. Diffutils-3.12 (cross)
name="diffutils-cross"
version="3.12"
source="https://ftp.gnu.org/gnu/diffutils/diffutils-3.12.tar.xz"
desc="File comparison utilities (temporary)"
deps="coreutils-cross"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    ./configure --prefix=/usr   \
                --host="$LFS_TGT" \
                --build="$(./build-aux/config.guess)"
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
}
