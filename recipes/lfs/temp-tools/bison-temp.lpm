# LFS 13.0 — 7.8. Bison-3.8.2 (chroot temporary)
name="bison-temp"
version="3.8.2"
source="https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"
desc="GNU parser generator (temporary)"
deps="gettext-temp"

build() {
    ./configure --prefix=/usr \
                --docdir=/usr/share/doc/bison-3.8.2
    make -j"$(nproc)"
    make install
}
