# LFS 13.0 — 6.18. GCC-15.2.0 (Pass 2)
name="gcc-pass2"
version="15.2.0"
source="https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
desc="GNU Compiler Collection (temporary pass 2)"
deps="binutils-pass2"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

    local mpfr gmp mpc
    mpfr=$(companion "mpfr-4.2.2.tar.xz" "https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz")
    gmp=$(companion  "gmp-6.3.0.tar.xz"  "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz")
    mpc=$(companion  "mpc-1.3.1.tar.gz"  "https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz")
    tar -xf "$mpfr"; mv -v mpfr-4.2.2 mpfr
    tar -xf "$gmp";  mv -v gmp-6.3.0  gmp
    tar -xf "$mpc";  mv -v mpc-1.3.1  mpc

    case $(uname -m) in
        x86_64)
            sed -e '/m64=/s/lib64/lib/' -i.orig gcc/config/i386/t-linux64
            ;;
    esac

    sed '/thread_header =/s/@.*@/gthr-posix.h/' \
        -i libgcc/Makefile.in libstdc++-v3/include/Makefile.in

    mkdir -v build
    cd build
    ../configure                                     \
        --build="$(../config.guess)"                 \
        --host="$LFS_TGT"                            \
        --target="$LFS_TGT"                          \
        LDFLAGS_FOR_TARGET="-L$PWD/$LFS_TGT/libgcc"  \
        --prefix=/usr                                \
        --with-build-sysroot="$LFS"                  \
        --enable-default-pie                         \
        --enable-default-ssp                         \
        --disable-nls                                \
        --disable-multilib                           \
        --disable-libatomic                          \
        --disable-libgomp                            \
        --disable-libquadmath                        \
        --disable-libsanitizer                       \
        --disable-libssp                             \
        --disable-libvtv                             \
        --enable-languages=c,c++
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
    ln -sv gcc "$LFS/usr/bin/cc"
}
