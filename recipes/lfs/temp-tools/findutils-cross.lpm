# LFS 13.0 — 6.8. Findutils-4.10.0 (cross)
name="findutils-cross"
version="4.10.0"
source="https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz"
desc="Utilities to find files (temporary)"
deps="file-cross"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    ./configure --prefix=/usr                   \
                --localstatedir=/var/lib/locate \
                --host="$LFS_TGT"              \
                --build="$(build-aux/config.guess)"
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
}
