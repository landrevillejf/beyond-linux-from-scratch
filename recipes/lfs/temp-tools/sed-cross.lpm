# LFS 13.0 — 6.14. Sed-4.9 (cross)
name="sed-cross"
version="4.9"
source="https://ftp.gnu.org/gnu/sed/sed-4.9.tar.xz"
desc="Stream editor (temporary)"
deps="patch-cross"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    ./configure --prefix=/usr   \
                --host="$LFS_TGT" \
                --build="$(./build-aux/config.guess)"
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
}
