# LFS 13.0 — 7.10. Python-3.13.7 (chroot temporary)
name="python-temp"
version="3.13.7"
source="https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tar.xz"
desc="Python interpreter (temporary)"
deps="perl-temp"

build() {
    ./configure --prefix=/usr   \
                --enable-shared \
                --without-ensurepip
    make -j"$(nproc)"
    make install
}
