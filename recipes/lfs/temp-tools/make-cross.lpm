# LFS 13.0 — 6.12. Make-4.4.1 (cross)
name="make-cross"
version="4.4.1"
source="https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz"
desc="GNU make build tool (temporary)"
deps="gzip-cross"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    ./configure --prefix=/usr   \
                --without-guile \
                --host="$LFS_TGT" \
                --build="$(build-aux/config.guess)"
    make -j"$(nproc)"
    make DESTDIR="$LFS" install
}
