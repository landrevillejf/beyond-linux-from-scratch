# LFS 13.0 — 5.3. GCC-15.2.0 (Pass 1)
# Cross compiler. Unpacks GMP/MPFR/MPC into its tree. Installs into $LFS/tools.
name="gcc-pass1"
version="15.2.0"
source="https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
desc="GNU Compiler Collection - cross toolchain pass 1"
deps="binutils-pass1"

build() {
    : "${LFS_TGT:?LFS_TGT must be set}"
    source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

    local mpfr gmp mpc
    mpfr=$(companion "mpfr-4.2.2.tar.xz" "https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz")
    gmp=$(companion  "gmp-6.3.0.tar.xz"  "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz")
    mpc=$(companion  "mpc-1.3.1.tar.gz"  "https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz")

    tar -xf "$mpfr"; mv -v mpfr-4.2.2 mpfr
    tar -xf "$gmp";  mv -v gmp-6.3.0  gmp
    tar -xf "$mpc";  mv -v mpc-1.3.1  mpc

    case $(uname -m) in
        x86_64)
            sed -e '/m64=/s/lib64/lib/' -i.orig gcc/config/i386/t-linux64
            ;;
    esac

    mkdir -v build
    cd build
    ../configure                  \
        --target="$LFS_TGT"       \
        --prefix="$LFS/tools"     \
        --with-glibc-version=2.42 \
        --with-sysroot="$LFS"     \
        --with-newlib             \
        --without-headers         \
        --enable-default-pie      \
        --enable-default-ssp      \
        --disable-nls             \
        --disable-shared          \
        --disable-multilib        \
        --disable-threads         \
        --disable-libatomic       \
        --disable-libgomp         \
        --disable-libquadmath     \
        --disable-libssp          \
        --disable-libvtv          \
        --disable-libstdcxx       \
        --enable-languages=c,c++
    make -j"$(nproc)"
    make install

    cd ..
    cat gcc/limitx.h gcc/glimits.h gcc/limity.h > \
        "$(dirname "$("$LFS_TGT-gcc" -print-libgcc-file-name)")/include/limits.h"
}
