# LFS 13.0 — 8.67. Kbd-2.8.0
name="kbd"
version="2.8.0"
source="https://www.kernel.org/pub/linux/utils/kbd/kbd-2.8.0.tar.xz"
desc="Keytable files and keyboard utilities"
deps="glibc"

build() {
    source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"
    local patch
    patch=$(companion "kbd-2.8.0-backspace-1.patch" \
        "https://www.linuxfromscratch.org/patches/lfs/13.0/kbd-2.8.0-backspace-1.patch") || true
    [ -f "$patch" ] && patch -Np1 -i "$patch"

    sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
    sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in

    ./configure --prefix=/usr --disable-vlock
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
}
