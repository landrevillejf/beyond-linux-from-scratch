# LFS 13.0 — 8.23. MPC-1.3.1
name="mpc"
version="1.3.1"
source="https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
desc="Complex-number arithmetic library"
deps="mpfr"

build() {
    ./configure --prefix=/usr    \
                --disable-static \
                --docdir=/usr/share/doc/mpc-1.3.1
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
}
