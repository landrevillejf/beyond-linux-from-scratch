# LFS 13.0 — 8.28. Shadow-4.18.0
# NOTE: password database configuration (pwconv, setting root password,
# enabling shadowed/group passwords) is a runtime step handled by the
# system stage scripts, not by this file-staging recipe.
name="shadow"
version="4.18.0"
source="https://github.com/shadow-maint/shadow/releases/download/4.18.0/shadow-4.18.0.tar.xz"
desc="Password and account management suite"
deps="libxcrypt"

build() {
    sed -i 's/groups$(EXEEXT) //' src/Makefile.in
    find man -name Makefile.in -exec sed -i 's/groups\.1 / /'   {} \;
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

    sed -e 's:#ENCRYPT_METHOD DES:ENCRYPT_METHOD YESCRYPT:' \
        -e 's:/var/spool/mail:/var/mail:'                   \
        -e '/PATH=/{s@/sbin:@@;s@/usr/sbin:@@}'             \
        -i etc/login.defs

    ./configure --sysconfdir=/etc   \
                --disable-static    \
                --without-libbsd    \
                --with-{b,yes}crypt \
                --without-libpam    \
                --with-group-name-max-length=32
    make -j"$(nproc)"
    make DESTDIR="$PKG" exec_prefix=/usr install
    make -C man DESTDIR="$PKG" install-man
}
