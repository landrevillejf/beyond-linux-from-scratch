# LFS 13.0 — 8.61. Gawk-5.3.2 (final)
name="gawk"
version="5.3.2"
source="https://ftp.gnu.org/gnu/gawk/gawk-5.3.2.tar.xz"
desc="GNU awk text processing utility"
deps="mpfr"

build() {
    sed -i 's/extras//' Makefile.in
    ./configure --prefix=/usr
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
}
