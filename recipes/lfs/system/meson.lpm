# LFS 13.0 — 8.57. Meson-1.8.3
name="meson"
version="1.8.3"
source="https://github.com/mesonbuild/meson/releases/download/1.8.3/meson-1.8.3.tar.gz"
desc="High productivity build system"
deps="ninja setuptools"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --no-user --find-links dist \
         --root="$PKG" meson
    install -vDm644 data/shell-completions/bash/meson \
        "$PKG/usr/share/bash-completion/completions/meson"
    install -vDm644 data/shell-completions/zsh/_meson \
        "$PKG/usr/share/zsh/site-functions/_meson"
}
