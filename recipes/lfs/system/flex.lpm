# LFS 13.0 — 8.15. Flex-2.6.4
name="flex"
version="2.6.4"
source="https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz"
desc="Fast lexical analyser generator"
deps="m4"

build() {
    ./configure --prefix=/usr \
                --docdir=/usr/share/doc/flex-2.6.4 \
                --disable-static
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
    ln -sv flex "$PKG/usr/bin/lex"
    ln -sv flex.1 "$PKG/usr/share/man/man1/lex.1"
}
