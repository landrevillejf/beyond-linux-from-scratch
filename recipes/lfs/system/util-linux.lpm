# LFS 13.0 — 8.81. Util-linux-2.41.1 (final)
name="util-linux"
version="2.41.1"
source="https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.1.tar.xz"
desc="Miscellaneous system utilities"
deps="ncurses zlib"

build() {
    ./configure --bindir=/usr/bin      \
                --libdir=/usr/lib      \
                --runstatedir=/run     \
                --sbindir=/usr/sbin    \
                --disable-chfn-chsh    \
                --disable-login        \
                --disable-nologin      \
                --disable-su           \
                --disable-setpriv      \
                --disable-runuser      \
                --disable-pylibmount   \
                --disable-liblastlog2  \
                --disable-static       \
                --without-python       \
                ADJTIME_PATH=/var/lib/hwclock/adjtime \
                --docdir=/usr/share/doc/util-linux-2.41.1
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
}
