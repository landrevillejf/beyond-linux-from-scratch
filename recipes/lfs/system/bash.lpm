# LFS 13.0 — 8.36. Bash-5.3 (final)
name="bash"
version="5.3"
source="https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz"
desc="Bourne-Again SHell"
deps="readline"

build() {
    ./configure --prefix=/usr             \
                --without-bash-malloc     \
                --with-installed-readline \
                --docdir=/usr/share/doc/bash-5.3
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
    ln -svf bash "$PKG/usr/bin/sh"
}
