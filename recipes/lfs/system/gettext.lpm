# LFS 13.0 — 8.33. Gettext-0.26 (final)
name="gettext"
version="0.26"
source="https://ftp.gnu.org/gnu/gettext/gettext-0.26.tar.xz"
desc="GNU internationalization and localization tools"
deps="acl"

build() {
    ./configure --prefix=/usr    \
                --disable-static \
                --docdir=/usr/share/doc/gettext-0.26
    make -j"$(nproc)"
    make DESTDIR="$PKG" install
    chmod -v 0755 "$PKG/usr/lib/preloadable_libintl.so"
}
