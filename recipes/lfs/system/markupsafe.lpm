# LFS 13.0 — 8.74. MarkupSafe-3.0.2
name="markupsafe"
version="3.0.2"
source="https://pypi.org/packages/source/M/MarkupSafe/markupsafe-3.0.2.tar.gz"
desc="Safe string implementation for Python templating"
deps="python"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --no-user --find-links dist \
         --root="$PKG" Markupsafe
}
