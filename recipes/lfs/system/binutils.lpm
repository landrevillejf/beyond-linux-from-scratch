# LFS 13.0 — 8.20. Binutils-2.45 (final)
name="binutils"
version="2.45"
source="https://sourceware.org/pub/binutils/releases/binutils-2.45.tar.xz"
desc="GNU Binary Utilities (assembler, linker, ...)"
deps="glibc"

build() {
    mkdir -v build
    cd build
    ../configure --prefix=/usr       \
                 --sysconfdir=/etc   \
                 --enable-ld=default \
                 --enable-plugins    \
                 --enable-shared     \
                 --disable-werror    \
                 --enable-64-bit-bfd \
                 --enable-new-dtags  \
                 --with-system-zlib  \
                 --enable-default-hash-style=gnu \
                 --enable-gprofng=no
    make tooldir=/usr -j"$(nproc)"
    make DESTDIR="$PKG" tooldir=/usr install
    rm -rfv "$PKG"/usr/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.a
    rm -fv  "$PKG"/usr/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.la
}
