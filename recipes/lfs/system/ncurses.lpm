# LFS 13.0 — 8.30. Ncurses-6.5 (final)
name="ncurses"
version="6.5"
source="https://invisible-mirror.net/archives/ncurses/current/ncurses-6.5-20250809.tgz"
desc="Terminal handling library"
deps="glibc"

build() {
    ./configure --prefix=/usr           \
                --mandir=/usr/share/man \
                --with-shared           \
                --without-debug         \
                --without-normal        \
                --with-cxx-shared       \
                --enable-pc-files       \
                --with-pkg-config-libdir=/usr/lib/pkgconfig
    make -j"$(nproc)"
    make DESTDIR="$PKG" install

    for lib in ncurses form panel menu ; do
        ln -sfv lib${lib}w.so "$PKG/usr/lib/lib${lib}.so"
        ln -sfv ${lib}w.pc    "$PKG/usr/lib/pkgconfig/${lib}.pc"
    done
    ln -sfv libncursesw.so "$PKG/usr/lib/libcurses.so"
    sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$PKG/usr/include/curses.h"
}
