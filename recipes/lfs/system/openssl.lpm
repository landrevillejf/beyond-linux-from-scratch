# LFS 13.0 — 8.48. OpenSSL-3.5.2
name="openssl"
version="3.5.2"
source="https://github.com/openssl/openssl/releases/download/openssl-3.5.2/openssl-3.5.2.tar.gz"
desc="Cryptography and TLS toolkit"
deps="glibc"

build() {
    ./config --prefix=/usr         \
             --openssldir=/etc/ssl \
             --libdir=lib          \
             shared                \
             zlib-dynamic
    make -j"$(nproc)"
    sed -i '/INSTALL_LIBS/s/libcrypto.a libssl.a//' Makefile
    make DESTDIR="$PKG" MANSUFFIX=ssl install
    mv -v "$PKG/usr/share/doc/openssl" "$PKG/usr/share/doc/openssl-3.5.2"
}
