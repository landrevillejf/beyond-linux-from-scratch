# LFS 13.0 — 8.53. Flit-Core-3.12.0
name="flit-core"
version="3.12.0"
source="https://pypi.org/packages/source/f/flit-core/flit_core-3.12.0.tar.gz"
desc="PEP 517 build backend for Flit"
deps="python"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --no-user --find-links dist \
         --root="$PKG" flit_core
}
