# LFS 13.0 — 8.54. Wheel-0.46.1
name="wheel"
version="0.46.1"
source="https://pypi.org/packages/source/w/wheel/wheel-0.46.1.tar.gz"
desc="Reference implementation of the Python wheel format"
deps="flit-core"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --no-user --find-links dist \
         --root="$PKG" wheel
}
