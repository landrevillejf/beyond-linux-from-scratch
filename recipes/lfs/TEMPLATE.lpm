# TEMPLATE — copy to <name>.lpm and edit.
#
# Metadata variables (all quoted strings):
name="example"                       # package name (used for the LPM database key)
version="1.0.0"                      # upstream version
source="https://example.org/example-1.0.0.tar.xz"  # tarball URL (or local path)
desc="One-line description"          # human-readable description
deps=""                              # comma/space separated runtime deps, e.g. "glibc,ncurses>=6.5"
# kernel_dep=""                       # optional: "modules" | "headers" | "runtime"
                                       # modules  – installs kernel modules (e.g. kmod, nvidia)
                                       # headers  – compiled against kernel headers (e.g. virtualbox)
                                       # runtime  – needs compatible kernel (e.g. glibc --enable-kernel)

# build() runs with the current directory set to the extracted source tree.
# The engine exports:
#   PKG   staging directory. Install here (make DESTDIR="$PKG" install) so LPM
#         can package the result and track it in its database.
#   SRC   the extracted source directory (== the current directory).
#   JOBS  configured parallel job count (you may also use $(nproc)).
# Recipes that must fetch companion tarballs (like GCC needing GMP/MPFR/MPC) can
# source the shared helper library:
#   source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"
# and call: companion "<file>" "<url>"  -> echoes the local path, downloading if needed.
build() {
    ./configure --prefix=/usr --disable-static
    make -j"$JOBS"
    make DESTDIR="$PKG" install
}
